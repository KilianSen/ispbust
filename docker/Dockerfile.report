# ispbust retrieval and reporting image.
#
# Pulls snapshots from the probes, analyses them, renders the fault report, and
# serves the results. No raw sockets, no privileges, no measurement of its own
# -- it can run anywhere on the network, including a machine that is asleep
# half the time.
#
#   docker build -f docker/Dockerfile.report -t ispbust-report:1.0.0 .

FROM python:3.12-slim-bookworm AS build

WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install .

# ---------------------------------------------------------------- runtime

FROM python:3.12-slim-bookworm

LABEL org.opencontainers.image.title="ispbust report" \
      org.opencontainers.image.description="Retrieval, analysis and fault report generation" \
      org.opencontainers.image.source="https://github.com/your/ispbust" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /install /usr/local

RUN useradd --system --uid 10002 --home /data --shell /usr/sbin/nologin ispbust \
 && mkdir -p /data /reports /etc/ispbust \
 && chown -R ispbust:ispbust /data /reports

USER ispbust
WORKDIR /data

ENV ISPBUST_SITE=/etc/ispbust/site.yaml \
    ISPBUST_DATA_DIR=/data \
    ISPBUST_REPORTS_DIR=/reports \
    ISPBUST_SERVE_PORT=8080 \
    ISPBUST_INTERVAL=21600 \
    ISPBUST_REPORT_DAYS=30 \
    PYTHONUNBUFFERED=1

EXPOSE 8080
VOLUME ["/data", "/reports"]

HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/',timeout=5).status==200 else 1)"]

ENTRYPOINT ["ispbust"]
# Rebuild the rolling report periodically and serve it. Override for one-shot
# use, e.g.:
#   docker run --rm ... ispbust-report report --from 2026-08-01 --to 2026-08-31 --out /reports/august.html
CMD ["serve"]
