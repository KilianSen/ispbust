# Copy to docker/.env and edit. `docker compose` reads it automatically.

# 'latest' tracks master. Pin a release tag (e.g. 1.0.0) for stability.
ISPBUST_VERSION=latest
# Point at your own registry, or a local build (ispbust)
ISPBUST_IMAGE_PREFIX=ghcr.io/kiliansen/ispbust
TZ=Europe/Berlin

# Your edited configs. Paths are relative to the docker/ directory.
# Defaults point at the annotated examples so a fresh clone starts.
UNDER_TEST_CONFIG=../examples/probe.under-test.yaml
CONTROL_CONFIG=../examples/probe.control.yaml
SITE_CONFIG=../examples/site.yaml

# Shared secret for the probes' /export/* endpoints.
# Generate with: openssl rand -hex 24
ISPBUST_EXPORT_TOKEN=

# Link identities. These appear verbatim in the report, so name them the way
# you would name them to your operator.
UNDER_TEST_ID=wan-a
UNDER_TEST_LABEL=Fibre line
CONTROL_ID=wan-b
CONTROL_LABEL=Backup link

# Report service
REPORT_PORT=8080
REBUILD_INTERVAL=21600      # seconds between rebuilds (6 hours)
REPORT_DAYS=30              # how many days back each rebuild covers
REPORT_LANGUAGE=            # de or en; empty uses site.yaml

# Optional dashboards (docker compose --profile metrics up -d)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=change-me
