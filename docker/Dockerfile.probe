# ispbust collection image.
#
# One container per WAN. Each must be pinned to exactly one uplink with
# failover disabled -- see docs/01-setup.md. The container needs CAP_NET_RAW
# for fping and mtr; grant it with `cap_add: [NET_RAW]` (compose) or
# `--cap-add=NET_RAW` (docker run).
#
#   docker build -f docker/Dockerfile.probe -t ispbust-probe:1.0.0 .

FROM python:3.12-slim-bookworm AS build

WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install .

# ---------------------------------------------------------------- runtime

FROM python:3.12-slim-bookworm

LABEL org.opencontainers.image.title="ispbust probe" \
      org.opencontainers.image.description="Continuous per-WAN line quality measurement" \
      org.opencontainers.image.source="https://github.com/your/ispbust" \
      org.opencontainers.image.licenses="MIT"

# fping does the measuring, mtr the path snapshots, libcap2-bin grants them the
# raw-socket capability so the process itself can stay unprivileged.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      fping \
      mtr-tiny \
      libcap2-bin \
      ca-certificates \
      tzdata \
 && setcap cap_net_raw+ep /usr/bin/fping \
 && setcap cap_net_raw+ep /usr/bin/mtr \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /install /usr/local

RUN useradd --system --uid 10001 --home /var/lib/ispbust --shell /usr/sbin/nologin ispbust \
 && mkdir -p /var/lib/ispbust/raw /etc/ispbust \
 && chown -R ispbust:ispbust /var/lib/ispbust

USER ispbust
WORKDIR /var/lib/ispbust

ENV ISPBUST_CONFIG=/etc/ispbust/probe.yaml \
    ISPBUST_DATA_DIR=/var/lib/ispbust \
    PYTHONUNBUFFERED=1

EXPOSE 9109
VOLUME ["/var/lib/ispbust"]

# A probe that has stopped measuring is worse than one that is obviously down,
# so the health check hits the probe's own liveness endpoint.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9109/health',timeout=5).status==200 else 1)"]

ENTRYPOINT ["ispbust"]
CMD ["probe"]
